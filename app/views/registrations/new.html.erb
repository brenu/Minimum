<div class="max-w-md mx-auto">
    <div class="bg-white p-10 rounded-3xl border border-gray-100 shadow-xl shadow-gray-100/50">
        <header class="text-center mb-10">
            <h1 class="text-3xl font-extrabold text-gray-900 tracking-tight mb-2">Join Minimum</h1>
            <p class="text-gray-500">Create your account and start your own blog today.</p>
        </header>

        <% if alert = flash[:alert] %>
            <div class="mb-6 p-4 bg-red-50 rounded-xl text-sm text-red-600 font-medium border border-red-100">
                <%= alert %>
            </div>
        <% end %>
    
        <% if notice = flash[:notice] %>
            <div class="mb-6 p-4 bg-green-50 rounded-xl text-sm text-green-600 font-medium border border-green-100">
                <%= notice %>
            </div>
        <% end %>

        <%= form_with model: @user, url: registration_url, class: "space-y-6" do |form| %>
            <div class="space-y-4">
                <div>
                    <%= form.label :email_address, class: "block text-sm font-bold text-gray-700 mb-2" %>
                    <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username", placeholder: "you@example.com", class: "block w-full px-4 py-3 rounded-xl border-gray-200 focus:border-gray-900 focus:ring-gray-900 transition-colors placeholder-gray-400 sm:text-sm", value: params[:email_address] %>
                </div>

                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <%= form.label :password, class: "block text-sm font-bold text-gray-700 mb-2" %>
                        <%= form.password_field :password, required: true, autocomplete: "new-password", placeholder: "••••••••", maxlength: 72, class: "block w-full px-4 py-3 rounded-xl border-gray-200 focus:border-gray-900 focus:ring-gray-900 transition-colors placeholder-gray-400 sm:text-sm" %>
                    </div>
                    <div>
                        <%= form.label :password_confirmation, "Confirm", class: "block text-sm font-bold text-gray-700 mb-2" %>
                        <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", placeholder: "••••••••", maxlength: 72, class: "block w-full px-4 py-3 rounded-xl border-gray-200 focus:border-gray-900 focus:ring-gray-900 transition-colors placeholder-gray-400 sm:text-sm" %>
                    </div>
                </div>
            </div>

            <div class="pt-6 border-t border-gray-100 space-y-4">
                <h2 class="text-sm font-bold uppercase tracking-widest text-gray-400">Blog Details</h2>
                
                <div>
                    <%= form.fields_for :blog do |blog_fields| %>
                        <div class="space-y-4">
                            <div>
                                <%= blog_fields.label :name, "Blog Name", class: "block text-sm font-bold text-gray-700 mb-2" %>
                                <%= blog_fields.text_field :name, required: true, placeholder: "The Daily Scoop", maxlength: 72, class: "block w-full px-4 py-3 rounded-xl border-gray-200 focus:border-gray-900 focus:ring-gray-900 transition-colors placeholder-gray-400 sm:text-sm" %>
                            </div>
                            
                            <div>
                                <%= blog_fields.label :description, class: "block text-sm font-bold text-gray-700 mb-2" %>
                                <%= blog_fields.text_area :description, required: true, placeholder: "What will you write about?", maxlength: 2000, rows: 3, class: "block w-full px-4 py-3 rounded-xl border-gray-200 focus:border-gray-900 focus:ring-gray-900 transition-colors placeholder-gray-400 sm:text-sm resize-none" %>
                            </div>

                            <div>
                                <%= blog_fields.label :cover, "Blog Cover Image", class: "block text-sm font-bold text-gray-700 mb-2" %>
                                <div class="mt-1 flex justify-center px-6 pt-5 pb-6 border-2 border-gray-200 border-dashed rounded-xl hover:border-gray-300 transition-colors cursor-pointer group">
                                    <div class="space-y-1 text-center">
                                        <svg class="mx-auto h-10 w-10 text-gray-400 group-hover:text-gray-500 transition-colors" stroke="currentColor" fill="none" viewBox="0 0 48 48" aria-hidden="true">
                                            <path d="M28 8H12a4 4 0 00-4 4v20m32-12v8m0 0v8a4 4 0 01-4 4H12a4 4 0 01-4-4v-4m32-4l-3.172-3.172a4 4 0 00-5.656 0L28 28M8 32l9.172-9.172a4 4 0 015.656 0L28 28m0 0l4 4m4-24h8m-4-4v8m-12 4h.02" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                                        </svg>
                                        <div class="flex text-sm text-gray-600">
                                            <%= blog_fields.file_field :cover, accept: "image/*", class: "sr-only", id: "blog_cover_input" %>
                                            <label for="blog_cover_input" class="relative cursor-pointer bg-white rounded-md font-bold text-gray-900 hover:text-gray-700 focus-within:outline-none">
                                                <span>Upload a file</span>
                                            </label>
                                            <p class="pl-1">or drag and drop</p>
                                        </div>
                                        <p class="text-xs text-gray-500">PNG, JPG, GIF up to 10MB</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    <% end %>
                </div>
            </div>

            <div class="pt-4">
                <%= form.submit "Create account", class: "w-full flex justify-center py-4 px-4 border border-transparent rounded-xl shadow-sm text-base font-bold text-white bg-gray-900 hover:bg-gray-800 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-gray-900 transition-all cursor-pointer" %>
            </div>
            
            <div class="text-center pt-4">
                <p class="text-sm text-gray-500">
                    Already have an account? 
                    <%= link_to "Sign in", new_session_path, class: "font-bold text-gray-900 hover:underline" %>
                </p>
            </div>
        <% end %>
    </div>
</div>