<div class="max-w-4xl mx-auto">
  <header class="mb-10">
    <%= link_to blog_path(id: @blog.id), class: "inline-flex items-center text-sm font-medium text-gray-500 hover:text-gray-900 transition-colors mb-8 group" do %>
      <svg class="w-4 h-4 mr-2 group-hover:-translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path></svg>
      Cancel and back to <%= @blog.name %>
    <% end %>
    <h1 class="text-3xl font-extrabold text-gray-900 tracking-tight">Create a story</h1>
  </header>

  <%= render "form", post: @post %>
</div>