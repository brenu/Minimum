<header class="mb-12">
  <h1 class="text-4xl font-extrabold text-gray-900 tracking-tight sm:text-5xl mb-4">Discover great writing</h1>
  <p class="text-xl text-gray-600 max-w-2xl">The best place to read and write about the things that matter to you.</p>
</header>

<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
    <% @blogs.each do |blog| %>
        <article class="group bg-white rounded-2xl border border-gray-100 shadow-sm hover:shadow-md transition-all duration-200 overflow-hidden flex flex-col">
            <%= link_to blog_path(blog.id), class: "block aspect-[16/9] overflow-hidden bg-gray-100" do %>
                <% if blog.cover.attached? %>
                    <%= image_tag blog.cover, class: "w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" %>
                <% else %>
                    <div class="w-full h-full flex items-center justify-center text-gray-400 bg-gradient-to-br from-gray-50 to-gray-100">
                        <svg class="w-12 h-12" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                    </div>
                <% end %>
            <% end %>
            
            <div class="p-6 flex-1 flex flex-col">
                <h2 class="text-xl font-bold text-gray-900 mb-2 group-hover:text-brand-primary transition-colors">
                    <%= link_to blog.name, blog_path(blog.id) %>
                </h2>
                <p class="text-gray-600 text-sm line-clamp-3 mb-4 flex-1">
                    <%= blog.description %>
                </p>
                <div class="pt-4 border-t border-gray-50 flex items-center justify-between">
                    <span class="text-xs font-semibold uppercase tracking-wider text-gray-400">Published by <%= blog.user.email_address.split('@').first %></span>
                    <%= link_to "Read Blog →", blog_path(blog.id), class: "text-sm font-bold text-gray-900 hover:text-brand-primary" %>
                </div>
            </div>
        </article>
    <% end %>
</div>
