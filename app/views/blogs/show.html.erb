<div class="mb-12 border-b border-gray-200 pb-12">
  <div class="max-w-3xl">
    <h1 class="text-4xl font-extrabold text-gray-900 mb-4 tracking-tight"><%= @blog.name %></h1>
    <p class="text-xl text-gray-600 leading-relaxed"><%= @blog.description %></p>

    <% if authenticated? && Current.user.blog == @blog %>
      <div class="mt-6 flex gap-4">
        <%= link_to "New Post", new_post_path(blog_id: @blog.id), class: "inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md shadow-sm text-white bg-gray-900 hover:bg-gray-800 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-gray-500 transition-colors" %>
      </div>
    <% end %>
  </div>
</div>

<div class="max-w-3xl">
  <h2 class="text-2xl font-bold text-gray-900 mb-8">Recent Posts</h2>

  <div class="space-y-12">
    <% @posts.each do |post| %>
      <article class="group relative">
        <%= link_to post_path(id: post.id), class: "block" do %>
          <div class="flex flex-col gap-2">
            <h3 class="text-2xl font-bold text-gray-900 group-hover:text-gray-600 transition-colors">
              <%= post.title %>
            </h3>
            <div class="text-gray-600 line-clamp-2 leading-relaxed prose prose-sm">
              <%= post.content.body.to_plain_text[0...160] %>...
            </div>
            <div class="mt-4 flex items-center gap-4 text-sm text-gray-500">
              <time datetime="<%= post.created_at.iso8601 %>"><%= post.created_at.strftime("%b %d, %Y") %></time>
              <span class="w-1 h-1 bg-gray-300 rounded-full"></span>
              <span><%= (post.content.body.to_plain_text.split.size / 200.0).ceil %> min read</span>
            </div>
          </div>
        <% end %>
      </article>
    <% end %>
  </div>

  <% if @posts.empty? %>
    <div class="text-center py-20 bg-gray-50 rounded-2xl border-2 border-dashed border-gray-200">
      <p class="text-gray-500">No posts yet. Check back soon!</p>
    </div>
  <% end %>
</div>
