<div class="max-w-md mx-auto">
    <div class="bg-white p-10 rounded-3xl border border-gray-100 shadow-xl shadow-gray-100/50">
        <header class="text-center mb-10">
            <h1 class="text-3xl font-extrabold text-gray-900 tracking-tight mb-2">Welcome back</h1>
            <p class="text-gray-500">Sign in to your account to continue.</p>
        </header>

        <% if alert = flash[:alert] %>
            <div class="mb-6 p-4 bg-red-50 rounded-xl text-sm text-red-600 font-medium border border-red-100">
                <%= alert %>
            </div>
        <% end %>
    
        <% if notice = flash[:notice] %>
            <div class="mb-6 p-4 bg-green-50 rounded-xl text-sm text-green-600 font-medium border border-green-100">
                <%= notice %>
            </div>
        <% end %>

        <%= form_with url: session_url, class: "space-y-6" do |form| %>
            <div>
                <%= form.label :email_address, class: "block text-sm font-bold text-gray-700 mb-2" %>
                <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username", placeholder: "you@example.com", value: params[:email_address], class: "block w-full px-4 py-3 rounded-xl border-gray-200 focus:border-gray-900 focus:ring-gray-900 transition-colors placeholder-gray-400 sm:text-sm" %>
            </div>

            <div>
                <div class="flex items-center justify-between mb-2">
                    <%= form.label :password, class: "block text-sm font-bold text-gray-700" %>
                    <%= link_to "Forgot password?", new_password_path, class: "text-xs font-bold text-gray-400 hover:text-gray-900 transition-colors" %>
                </div>
                <%= form.password_field :password, required: true, autocomplete: "current-password", placeholder: "••••••••", maxlength: 72, class: "block w-full px-4 py-3 rounded-xl border-gray-200 focus:border-gray-900 focus:ring-gray-900 transition-colors placeholder-gray-400 sm:text-sm" %>
            </div>

            <div class="pt-2">
                <%= form.submit "Sign in", class: "w-full flex justify-center py-4 px-4 border border-transparent rounded-xl shadow-sm text-base font-bold text-white bg-gray-900 hover:bg-gray-800 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-gray-900 transition-all cursor-pointer" %>
            </div>
            
            <div class="text-center pt-4">
                <p class="text-sm text-gray-500">
                    No account? 
                    <%= link_to "Create one", new_registration_path, class: "font-bold text-gray-900 hover:underline" %>
                </p>
            </div>
        <% end %>
    </div>
</div>
