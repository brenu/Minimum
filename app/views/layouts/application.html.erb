<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Minimum" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Minimum">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-gray-50 text-gray-900 font-sans antialiased">
    <nav class="bg-white border-b border-gray-200 sticky top-0 z-50">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex justify-between h-16 items-center">
          <div class="flex items-center gap-8">
            <%= link_to "Minimum", root_path, class: "text-2xl font-bold text-gray-900 tracking-tight" %>
            <div class="hidden sm:flex items-center gap-4">
              <%= link_to "Explore", root_path, class: "text-sm font-medium text-gray-600 hover:text-gray-900 transition-colors" %>
            </div>
          </div>

          <div class="flex items-center gap-4">
            <% if authenticated? %>
              <%= link_to "My Blog", blog_path(Current.user.blog), class: "text-sm font-medium text-gray-600 hover:text-gray-900 transition-colors" if Current.user.blog %>
              <%= button_to "Log out", session_path, method: :delete, class: "text-sm font-medium text-red-600 hover:text-red-700 transition-colors" %>
            <% else %>
              <%= link_to "Sign in", new_session_path, class: "text-sm font-medium text-gray-600 hover:text-gray-900 transition-colors" %>
              <%= link_to "Sign up", new_registration_path, class: "bg-gray-900 text-white px-4 py-2 rounded-full text-sm font-medium hover:bg-gray-800 transition-colors shadow-sm" %>
            <% end %>
          </div>
        </div>
      </div>
    </nav>

    <main class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
      <%= yield %>
    </main>
  </body>
</html>
